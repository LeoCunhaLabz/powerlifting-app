{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@onyx/calc": ["./../web/src/utils/powerlifting.ts"],
      "@onyx/strength": ["./../web/src/utils/strength.ts"]
    },
    "types": ["astro/client", "vite/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*"],
  "exclude": ["dist"]
}
