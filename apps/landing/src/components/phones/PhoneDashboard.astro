---
import PhoneFrame from './PhoneFrame.astro';
import { calculateDots } from '@onyx/calc';
import { formatNumber } from '../../lib/format';
import './phones.css';

// Amostra coerente: e1RMs 180 / 122,5 / 210 → total 512,5 a 82,5 kg (calculado de verdade).
const dots = calculateDots(82.5, 180 + 122.5 + 210, true);
---

<PhoneFrame size="lg" activeTab={0}>
  <div class="ph-row">
    <div class="ph-col">
      <span class="ph-eyebrow">ONYX</span>
      <span class="ph-title ph-title--lg">Pronto pra treinar</span>
    </div>
    <span class="ph-pill">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c1 4-2 5-2 8a4 4 0 0 0 8 .5C18 14 22 12 19 6c-1 3-2 3-2 1 0-2-2-4-5-5z"></path></svg>
      3 sem
    </span>
  </div>

  <div class="ph-card ph-card--lg ph-card--accent ph-row" style="padding:16px">
    <div class="ph-col" style="gap:3px">
      <span class="ph-label" style="color:var(--accent);font-size:9px;letter-spacing:1.4px">Próxima rotina</span>
      <span class="ph-num" style="font-size:17px">Agachamento pesado</span>
      <span class="ph-sub" style="font-size:11px">Madcow 5x5 · 6 exercícios</span>
    </div>
    <span class="play">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="var(--accent-ink)" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg>
    </span>
  </div>

  <div class="ph-grid3">
    <div class="ph-card ph-stat"><span class="ph-num">4</span><span class="ph-label">Sessões</span></div>
    <div class="ph-card ph-stat"><span class="ph-num">12,4t</span><span class="ph-label">Tonelagem</span></div>
    <div class="ph-card ph-stat"><span class="ph-num">3,2</span><span class="ph-label">Média · 4 sem</span></div>
  </div>

  <div class="ph-card ph-card--lg ph-col" style="padding:14px;gap:8px">
    <div class="ph-row">
      <span style="font-size:11px;font-weight:700;color:var(--text-primary)">Evolução</span>
      <span class="ph-seg"><span class="is-on">e1RM</span><span>Força rel.</span></span>
    </div>
    <svg width="100%" height="60" viewBox="0 0 280 60" preserveAspectRatio="none" aria-hidden="true">
      <polyline points="0,48 28,44 56,46 84,38 112,34 140,36 168,27 196,23 224,16 252,14 280,9" fill="none" stroke="var(--accent)" stroke-width="2.4"></polyline>
    </svg>
  </div>

  <div class="ph-card ph-card--lg ph-col" style="padding:14px;gap:10px">
    <div class="ph-row">
      <span style="font-size:11px;font-weight:700;color:var(--text-primary)">Recordes</span>
      <span class="ph-pill" style="font-size:10px;padding:3px 8px">{formatNumber(dots, 0)} DOTS</span>
    </div>
    <div class="ph-grid3" style="gap:0">
      <div class="pr"><span class="ph-label">Agach.</span><span class="ph-num" style="font-size:17px">180</span><span class="ph-label" style="letter-spacing:0">e1RM</span></div>
      <div class="pr pr--mid"><span class="ph-label">Supino</span><span class="ph-num" style="font-size:17px">122,5</span><span class="ph-label" style="letter-spacing:0">e1RM</span></div>
      <div class="pr"><span class="ph-label">Terra</span><span class="ph-num" style="font-size:17px">210</span><span class="ph-label" style="letter-spacing:0">e1RM</span></div>
    </div>
  </div>
</PhoneFrame>

<style>
  .play {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .pr {
    display: flex;
    flex-direction: column;
    gap: 1px;
    align-items: center;
  }

  .pr--mid {
    border-left: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
  }
</style>
