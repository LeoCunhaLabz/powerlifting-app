---
/** Marca ONYX: anel brass (favicon.svg) + wordmark Outfit 900 (logo.svg). */
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}
const { size = 26, wordmark = true, class: className = '' } = Astro.props;
const fontSize = Math.round(size * 0.77);
---

<span class={`logo ${className}`}>
  <svg width={size} height={size} viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <circle cx="60" cy="60" r="34" stroke="var(--accent)" stroke-width="14"></circle>
  </svg>
  {wordmark && <span class="logo__word" style={`font-size:${fontSize}px`}>ONYX</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
  }

  .logo__word {
    font-family: var(--font-display);
    font-weight: 900;
    letter-spacing: 2px;
    line-height: 1;
    color: var(--text-primary);
  }
</style>
