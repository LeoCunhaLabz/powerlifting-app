---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import ForYou from '../sections/ForYou.astro';
import Differentials from '../sections/Differentials.astro';
import AppShowcase from '../sections/AppShowcase.astro';
import CalculatorCards from '../sections/CalculatorCards.astro';
import Comparison from '../sections/Comparison.astro';
import FinalCta from '../sections/FinalCta.astro';
import { SITE_URL, APP_URL, DEFAULT_DESCRIPTION, HERO_TITLE, HERO_SUBTITLE, HOME_TITLE } from '../lib/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ONYX',
    url: SITE_URL,
    inLanguage: 'pt-BR',
    description: DEFAULT_DESCRIPTION,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ONYX: Powerlifting',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web, Android',
    url: APP_URL,
    inLanguage: 'pt-BR',
    description: `${HERO_TITLE} ${HERO_SUBTITLE}`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
    // Em linguagem simples: é isto que o Google mostra (issue #317, spec §3).
    featureList: [
      'Registra cada série com o esforço (RPE)',
      'Calcula a carga do dia sobre o seu máximo atual',
      'Mostra se você é forte pro seu peso (DOTS, Wilks e IPF GL)',
      'Funciona sem internet e sincroniza depois',
      'Calculadora de anilhas por lado',
    ],
  },
];
---

<BaseLayout title={HOME_TITLE} description={DEFAULT_DESCRIPTION} path="/" jsonLd={jsonLd}>
  <Hero />
  <ForYou />
  <Differentials />
  <AppShowcase />
  <CalculatorCards />
  <Comparison />
  <FinalCta />
</BaseLayout>
