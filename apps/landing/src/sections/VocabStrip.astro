---
import LogoLoop from '../components/reactbits/LogoLoop';
import { VOCAB } from '../lib/site';

// LogoLoop (reactbits) roda em rAF: só hidrata em desktop sem reduced-motion.
// Sem hidratação (mobile/crawler) o HTML do servidor é a faixa estática.
const logos = VOCAB.map((term) => ({ node: term, title: term }));
---

<section class="vocab" aria-label="Vocabulário do powerlifting no ONYX">
  <LogoLoop
    client:media="(min-width: 1024px) and (prefers-reduced-motion: no-preference)"
    logos={logos}
    speed={40}
    gap={44}
    logoHeight={13}
    fadeOut
    fadeOutColor="#060606"
    ariaLabel="Vocabulário: RPE, %1RM, e1RM, DOTS, IPF GL, Wilks, total SBD"
    className="vocab__loop"
  />
</section>

<style>
  .vocab {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 22px 0;
    overflow: hidden;
  }

  .vocab :global(.logoloop__node) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--text-muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Separador brass entre os termos (spec: "RPE · %1RM · …") */
  .vocab :global(.logoloop__item) {
    position: relative;
  }

  .vocab :global(.logoloop__item)::after {
    content: '';
    position: absolute;
    right: calc(var(--logoloop-gap) / -2);
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 640px) {
    .vocab {
      padding: 18px 0;
    }

    .vocab :global(.logoloop__node) {
      font-size: 11px;
      letter-spacing: 2px;
    }
  }
</style>
