---
import SectionHeader from '../components/SectionHeader.astro';
import { CENARIOS } from '../data/cenarios';

// Seção 3 da home (issue #317, spec §4): ocupa o lugar da antiga faixa de siglas.
// Três cenários estáticos — a pessoa se reconhece antes de ver termo técnico.
---

<section class="section section--hairline-top foryou" aria-label="Isso é pra você">
  <div class="container">
    <SectionHeader kicker="Isso é pra você" title="Você treina assim?" />

    <div class="foryou__grid">
      {
        CENARIOS.map((cenario) => (
          <article class="card foryou__card">
            <h3 class="foryou__title">{cenario.title}</h3>
            <p>{cenario.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .foryou__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 36px;
  }

  .foryou__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
  }

  .foryou__title {
    font-size: 17px;
    line-height: 1.3;
  }

  .foryou__card p {
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .foryou__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      margin-top: 28px;
    }

    .foryou__card {
      padding: 20px;
    }
  }
</style>
