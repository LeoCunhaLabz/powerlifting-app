---
import SectionHeader from '../components/SectionHeader.astro';
import { DIFFERENTIALS, type DifferentialIcon } from '../data/diferenciais';

const ICONS: Record<DifferentialIcon, string> = {
  bars: '<path d="M12 20V10"></path><path d="M18 20V4"></path><path d="M6 20v-4"></path>',
  percent: '<path d="M19 5L5 19"></path><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle>',
  clock: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
  wifi: '<path d="M1 9c4-4 9-6 11-6s7 2 11 6"></path><path d="M5 13c2.5-2.5 5-4 7-4s4.5 1.5 7 4"></path><circle cx="12" cy="18" r="1.5"></circle>',
  globe: '<circle cx="12" cy="12" r="9"></circle><path d="M3.5 9h17"></path><path d="M3.5 15h17"></path><path d="M12 3a15 15 0 0 1 0 18"></path><path d="M12 3a15 15 0 0 0 0 18"></path>',
  check: '<path d="M20 6L9 17l-5-5"></path>',
};

// Única seção sem gsap/motion: a interatividade dela é o próprio carrossel de
// scroll horizontal (CSS scroll-snap + JS vanilla para setas/dots), que funciona
// igual em desktop (arraste/roda) e mobile (swipe) — sem violar a regra de perf
// "gsap só desktop" porque não usa gsap nenhum.
---

<section id="recursos" class="section diff" aria-labelledby="diff-title">
  <div class="container">
    <div class="diff__head">
      <SectionHeader kicker="Por que não um app genérico" title="Feito para quem treina com barra." />
      <div class="diff__nav">
        <button type="button" class="diff__arrow" id="diff-prev" aria-label="Card anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <button type="button" class="diff__arrow" id="diff-next" aria-label="Próximo card">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </div>
    </div>

    <div class="diff__track" id="diff-track" role="list">
      {
        DIFFERENTIALS.map((d) => (
          <article class="card diff__card" role="listitem">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[d.icon]} />
            <h3 class="diff__title">{d.title}</h3>
            <p>{d.text}</p>
          </article>
        ))
      }
    </div>

    <div class="diff__dots" id="diff-dots" aria-hidden="true">
      {DIFFERENTIALS.map((_, i) => <span class="diff__dot" data-i={i} />)}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('diff-track');
  const prevBtn = document.getElementById('diff-prev');
  const nextBtn = document.getElementById('diff-next');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('#diff-dots .diff__dot'));

  if (track) {
    const scrollByCard = (dir: number) => {
      const card = track.querySelector('.diff__card');
      const gap = 16;
      const cardWidth = card ? card.getBoundingClientRect().width : 280;
      track.scrollBy({ left: dir * (cardWidth + gap), behavior: 'smooth' });
    };
    prevBtn?.addEventListener('click', () => scrollByCard(-1));
    nextBtn?.addEventListener('click', () => scrollByCard(1));

    const updateDots = () => {
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.diff__card'));
      const trackRect = track.getBoundingClientRect();
      const centerX = trackRect.left + trackRect.width / 2;
      let closest = 0;
      let minDist = Infinity;
      cards.forEach((c, i) => {
        const r = c.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - centerX);
        if (dist < minDist) {
          minDist = dist;
          closest = i;
        }
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === closest));
    };

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            updateDots();
            ticking = false;
          });
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', updateDots);
    updateDots();
  }
</script>

<style>
  .diff {
    padding-top: 8px;
  }

  .diff__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
  }

  .diff__nav {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
  }

  .diff__arrow {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .diff__arrow:hover {
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .diff__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .diff__track::-webkit-scrollbar {
    display: none;
  }

  .diff__card {
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal),
      border-color var(--transition-normal);
  }

  @media (hover: hover) {
    .diff__card:hover {
      transform: translateY(-4px);
      border-color: var(--accent-border);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);
    }
  }

  .diff__title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .diff__card p {
    font-size: 14px;
    line-height: 1.6;
  }

  .diff__dots {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin-top: 20px;
  }

  .diff__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--border-color);
    transition:
      background var(--transition-fast),
      width var(--transition-fast);
  }

  .diff__dot.is-active {
    background: var(--accent);
    width: 18px;
  }

  @media (prefers-reduced-motion: reduce) {
    .diff__track {
      scroll-behavior: auto;
    }

    .diff__card {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .diff__head {
      margin-bottom: 22px;
    }
  }

  @media (max-width: 640px) {
    .diff__nav {
      display: none;
    }

    .diff__card {
      width: 78vw;
      max-width: 320px;
      padding: 20px;
    }
  }
</style>
