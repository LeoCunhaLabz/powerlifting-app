---
import ElectricBorder from '../components/reactbits/ElectricBorder';
import FadeContent from '../components/reactbits/FadeContent';
import SectionHeader from '../components/SectionHeader.astro';
import Logo from '../components/Logo.astro';
import { COMPARISON_ROWS, COMPARISON_COLUMNS, COMPARISON_FOOTNOTE, CELL_LABEL, type Cell } from '../data/comparativo';

const MEDIA = '(min-width: 1024px) and (prefers-reduced-motion: no-preference)';

// Cada coluna é um grid com `grid-template-rows: subgrid` alinhado às linhas do pai,
// para a coluna ONYX ser um único box (o ElectricBorder precisa de um elemento para
// contornar). Mobile (≤ 480px): Strong/Hevy/Outros somem e "Outros apps" aparece.
const rowsTemplate = `auto repeat(${COMPARISON_ROWS.length}, auto)`;
const cellText = (c: Cell) => CELL_LABEL[c.value];
---

<section id="comparativo" class="section section--hairline-top cmp" aria-labelledby="cmp-title">
  <div class="container">
    <div class="cmp__head">
      <SectionHeader kicker="Sem rodeios" title="Compare com o app que você usa hoje." />
    </div>

    <FadeContent client:media={MEDIA} duration={0.8} threshold={0.1} className="cmp__fade">
      <div class="cmp__table" role="table" aria-label="Comparativo ONYX, Strong, Hevy e outros apps" style={`--rows:${rowsTemplate}`}>
        <!-- Coluna de critérios -->
        <div class="cmp__col cmp__col--crit" role="rowgroup">
          <div class="cmp__cell cmp__cell--head" role="columnheader"><span class="sr-only">Critério</span></div>
          {
            COMPARISON_ROWS.map((r) => (
              <div class="cmp__cell cmp__crit" role="rowheader">
                <span class="cmp__crit-title">{r.criterio}</span>
                <span class="cmp__crit-short">{r.criterioCurto}</span>
                <span class="cmp__crit-detail">{r.detalhe}</span>
              </div>
            ))
          }
        </div>

        <!-- Coluna ONYX (destaque brass + Electric Border em desktop) -->
        <ElectricBorder client:media={MEDIA} color="#e3a83b" speed={0.6} chaos={0.06} borderRadius={12} className="cmp__col cmp__col--onyx">
          <div class="cmp__onyx" role="rowgroup">
            <div class="cmp__cell cmp__cell--head cmp__cell--onyx-head" role="columnheader">
              <Logo size={22} />
            </div>
            {
              COMPARISON_ROWS.map((r) => (
                <div class="cmp__cell cmp__cell--onyx" role="cell">
                  <span class="cmp__check" aria-label="sim">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent-ink)" stroke-width="3.2" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
                  </span>
                  <span class="sr-only">{cellText(r.onyx)}</span>
                </div>
              ))
            }
          </div>
        </ElectricBorder>

        <!-- Strong -->
        <div class="cmp__col cmp__col--wide" role="rowgroup">
          <div class="cmp__cell cmp__cell--head" role="columnheader"><span class="cmp__brand">{COMPARISON_COLUMNS.strong}</span></div>
          {COMPARISON_ROWS.map((r) => <div class="cmp__cell" role="cell" data-v={r.strong.value}>{cellText(r.strong)}</div>)}
        </div>

        <!-- Hevy -->
        <div class="cmp__col cmp__col--wide" role="rowgroup">
          <div class="cmp__cell cmp__cell--head" role="columnheader"><span class="cmp__brand">{COMPARISON_COLUMNS.hevy}</span></div>
          {COMPARISON_ROWS.map((r) => <div class="cmp__cell" role="cell" data-v={r.hevy.value}>{cellText(r.hevy)}</div>)}
        </div>

        <!-- Outros (desktop) -->
        <div class="cmp__col cmp__col--wide" role="rowgroup">
          <div class="cmp__cell cmp__cell--head" role="columnheader">
            <span class="cmp__brand">{COMPARISON_COLUMNS.outros}</span>
            <span class="cmp__brand-sub">{COMPARISON_COLUMNS.outrosSub}</span>
          </div>
          {COMPARISON_ROWS.map((r) => <div class="cmp__cell" role="cell" data-v={r.outros.value}>{cellText(r.outros)}</div>)}
        </div>

        <!-- Outros apps (mobile: Strong + Hevy + genéricos colapsados) -->
        <div class="cmp__col cmp__col--narrow" role="rowgroup">
          <div class="cmp__cell cmp__cell--head" role="columnheader">
            <span class="cmp__brand">{COMPARISON_COLUMNS.outrosApps}</span>
            <span class="cmp__brand-sub">{COMPARISON_COLUMNS.outrosAppsSub}</span>
          </div>
          {COMPARISON_ROWS.map((r) => <div class="cmp__cell" role="cell" data-v={r.outrosApps.value}>{cellText(r.outrosApps)}</div>)}
        </div>
      </div>
    </FadeContent>

    <p class="cmp__note">{COMPARISON_FOOTNOTE}</p>
  </div>
</section>

<style>
  .cmp__head {
    margin-bottom: 36px;
  }

  .cmp__table {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    grid-template-rows: var(--rows);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-primary);
  }

  .cmp :global(.cmp__col) {
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
    min-width: 0;
  }

  .cmp__onyx {
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
    height: 100%;
  }

  /* ElectricBorder envolve a coluna ONYX; seu conteúdo precisa herdar o subgrid */
  .cmp :global(.cmp__col--onyx) {
    border-radius: 0;
    background: var(--accent-soft);
    border-left: 1px solid var(--accent-border);
    border-right: 1px solid var(--accent-border);
    box-shadow: 0 0 34px var(--accent-soft);
  }

  .cmp :global(.cmp__col--onyx .eb-content) {
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
    height: 100%;
  }

  .cmp :global(.cmp__col--onyx .eb-layers),
  .cmp :global(.cmp__col--onyx .eb-canvas-container) {
    /* sem glow difuso por trás da tabela — só a linha elétrica */
    opacity: 0.8;
  }

  .cmp :global(.cmp__col--onyx .eb-background-glow) {
    display: none;
  }

  .cmp__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    border-bottom: 1px solid var(--bg-tertiary);
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    text-align: center;
  }

  .cmp__col > .cmp__cell:last-child,
  .cmp__onyx > .cmp__cell:last-child {
    border-bottom: none;
  }

  .cmp__cell--head {
    background: var(--bg-table);
    border-bottom: 1px solid var(--border-color);
    flex-direction: column;
    gap: 4px;
    padding: 22px 12px;
  }

  .cmp__cell--onyx-head {
    background: linear-gradient(180deg, rgba(227, 168, 59, 0.14), rgba(227, 168, 59, 0.05));
    border-bottom: 1px solid var(--accent-border);
  }

  .cmp__cell--onyx {
    background: rgba(227, 168, 59, 0.05);
  }

  .cmp__onyx > .cmp__cell:last-child {
    background: linear-gradient(0deg, rgba(227, 168, 59, 0.14), rgba(227, 168, 59, 0.05));
  }

  .cmp__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--text-secondary);
  }

  .cmp__brand-sub {
    font-size: 10px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .cmp__crit {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 3px;
    text-align: left;
    padding: 20px 26px;
  }

  .cmp__crit-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cmp__crit-short {
    display: none;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cmp__crit-detail {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .cmp__check {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cmp__cell[data-v='nao'] {
    font-size: 0;
  }

  .cmp__cell[data-v='nao']::before {
    content: '';
    width: 14px;
    height: 14px;
    background:
      linear-gradient(var(--text-muted), var(--text-muted)) center / 2.4px 100% no-repeat,
      linear-gradient(var(--text-muted), var(--text-muted)) center / 100% 2.4px no-repeat;
    transform: rotate(45deg);
    border-radius: 1px;
  }

  .cmp__note {
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 16px;
  }

  /* mobile: colapsa Strong/Hevy/Outros em "Outros apps" */
  .cmp :global(.cmp__col--narrow) {
    display: none;
  }

  @media (max-width: 1023px) {
    .cmp__head {
      margin-bottom: 24px;
    }

    .cmp__cell {
      padding: 14px 8px;
      font-size: 12px;
    }

    .cmp__crit {
      padding: 14px 14px;
    }

    .cmp__crit-detail {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .cmp__table {
      grid-template-columns: 1.5fr 1fr 1fr;
    }

    .cmp :global(.cmp__col--wide) {
      display: none;
    }

    .cmp :global(.cmp__col--narrow) {
      display: grid;
    }

    .cmp__crit-title {
      display: none;
    }

    .cmp__crit-short {
      display: block;
    }

    .cmp__cell {
      padding: 12px 4px;
      font-size: 10px;
    }

    .cmp__crit {
      padding: 14px 12px;
    }

    .cmp__cell--head {
      padding: 12px 4px;
    }

    .cmp__brand {
      font-size: 11px;
    }

    .cmp__brand-sub {
      font-size: 8px;
    }

    .cmp__check {
      width: 19px;
      height: 19px;
    }

    .cmp__check svg {
      width: 10px;
      height: 10px;
    }
  }
</style>
