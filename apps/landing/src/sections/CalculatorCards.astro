---
import SectionHeader from '../components/SectionHeader.astro';
import PlateBar from '../islands/PlateBar';
import { calculateDots, calculateE1RM, calculatePlates, DEFAULT_PLATES_KG } from '@onyx/calc';
import { formatKg, formatNumber } from '../lib/format';
import { ROUTES } from '../lib/site';

// Amostras calculadas de verdade no build (gate 3 da spec: nada de número inventado).
const sampleDots = calculateDots(82.5, 512.5, true);
const sampleE1rm = calculateE1RM(150, 5, 8);
const samplePlates = calculatePlates(142.5, 20, DEFAULT_PLATES_KG);
---

<section id="calculadoras" class="section calcs" aria-labelledby="calcs-title">
  <div class="container">
    <div class="calcs__head">
      <SectionHeader
        kicker="Ferramentas grátis, sem conta"
        title="Cálculos abertos, sem criar conta."
        lead="Os mesmos cálculos que o app faz durante o treino, abertos pra qualquer um, direto no navegador."
      />
    </div>

    <div class="calcs__grid">
      <article class="calcs__card">
        <a class="calcs__link" href={ROUTES.calcDots}>
          <h3 class="calcs__title">Sua força pelo peso corporal</h3>
          <span class="label calcs__term">DOTS · Wilks · IPF GL</span>
          <p>Quanto vale o seu total para quem pesa o que você pesa, nas três fórmulas que o esporte usa.</p>
          <div class="calcs__sample">
            <span class="num calcs__big">{formatNumber(sampleDots, 1)}</span>
            <span class="calcs__unit">DOTS · 82,5 kg / 512,5 kg</span>
          </div>
          <span class="calcs__cta">Calcular DOTS →</span>
        </a>
      </article>

      <article class="calcs__card">
        <a class="calcs__link" href={ROUTES.calc1rm}>
          <h3 class="calcs__title">Quanto você levanta 1 vez?</h3>
          <span class="label calcs__term">1RM por RPE</span>
          <p>Estime o seu máximo a partir de uma série que você já fez, sem precisar tentar o máximo.</p>
          <div class="calcs__sample">
            <span class="num calcs__big">{formatKg(sampleE1rm)}</span>
            <span class="calcs__unit">kg · 150 × 5 @ RPE 8</span>
          </div>
          <span class="calcs__cta">Estimar 1RM →</span>
        </a>
      </article>

      <article class="calcs__card">
        <a class="calcs__link" href={ROUTES.calcAnilhas}>
          <h3 class="calcs__title">Como montar a barra</h3>
          <span class="label calcs__term">Anilhas por lado</span>
          <p>As anilhas de cada lado para chegar no peso que você quer, nas cores oficiais.</p>
          <div class="calcs__sample calcs__sample--bar">
            <PlateBar plates={samplePlates.plates} scale={0.6} />
            <span class="num calcs__mid">{formatKg(142.5)} <span class="calcs__unit">kg</span></span>
          </div>
          <span class="calcs__cta">Montar a barra →</span>
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .calcs__head {
    margin-bottom: 40px;
  }

  .calcs__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .calcs__card {
    display: flex;
    padding: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-fast);
  }

  .calcs__card:hover {
    border-color: var(--border-focus);
  }

  .calcs__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    width: 100%;
    color: inherit;
    position: relative;
    z-index: 1;
  }

  .calcs__link p {
    font-size: 14px;
    line-height: 1.6;
  }

  .calcs__title {
    font-size: 17px;
    line-height: 1.3;
  }

  /* Termo técnico como legenda do título em pergunta (spec §5). */
  .calcs__term {
    margin-top: -6px;
    color: var(--text-muted);
  }

  .calcs__sample {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .calcs__sample--bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .calcs__sample--bar :global(.bar) {
    min-height: 0;
    padding: 8px 6px;
    background: transparent;
    border: none;
    justify-content: flex-start;
    width: 100%;
  }

  .calcs__big {
    font-size: 34px;
  }

  .calcs__mid {
    font-size: 18px;
  }

  .calcs__unit {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .calcs__cta {
    margin-top: auto;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .calcs__link:hover .calcs__cta {
    color: var(--accent);
  }

  @media (max-width: 1023px) {
    .calcs__grid {
      grid-template-columns: 1fr;
    }

    .calcs__head {
      margin-bottom: 24px;
    }
  }

  @media (max-width: 640px) {
    .calcs__link {
      padding: 18px;
      gap: 8px;
    }

    .calcs__link p {
      display: none;
    }

    .calcs__sample {
      display: none;
    }

    .calcs__cta {
      margin-top: 4px;
    }
  }
</style>
