---
import DotsCalculator from '../islands/DotsCalculator';
import CtaButtons from '../components/CtaButtons.astro';
import { HERO_TITLE_PREFIX, HERO_TITLE_ACCENT, HERO_SUBTITLE } from '../lib/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="kicker">App de treino · Powerlifting</span>
      <h1 id="hero-title" class="hero__title">
        {HERO_TITLE_PREFIX}<span class="hero__accent">{HERO_TITLE_ACCENT}</span>.
      </h1>
      <p class="hero__sub">{HERO_SUBTITLE}</p>
      <CtaButtons />
      <p class="hero__note">Sem cartão. As calculadoras funcionam sem conta, direto no navegador.</p>
    </div>

    <div class="hero__calc">
      <DotsCalculator client:load />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--bg-primary);
  }

  .hero__inner {
    display: flex;
    gap: 72px;
    align-items: center;
    padding-top: 96px;
    padding-bottom: 104px;
  }

  .hero__copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 620px;
  }

  .hero__title {
    font-size: clamp(32px, 4.2vw, 52px);
    line-height: 1.08;
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__sub {
    font-size: 19px;
    line-height: 1.55;
    max-width: 520px;
  }

  .hero__note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .hero__calc {
    width: 440px;
    flex: 0 0 auto;
  }

  @media (max-width: 1023px) {
    .hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 36px;
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .hero__calc {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }

    .hero__copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero__inner {
      padding-top: 44px;
      padding-bottom: 40px;
      gap: 28px;
    }

    .hero__copy {
      gap: 18px;
    }

    .hero__sub {
      font-size: 16px;
    }

    .hero__note {
      text-align: center;
    }
  }
</style>
