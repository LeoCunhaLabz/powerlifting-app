---
import StrengthCalculator from '../islands/StrengthCalculator';
import CtaButtons from '../components/CtaButtons.astro';
import { HERO_TITLE, HERO_SUBTITLE } from '../lib/site';

// Layout em grid areas (issue #317): no desktop a calculadora ocupa a coluna da
// direita nas duas linhas; no mobile a ordem vira **título → calculadora → CTAs**,
// porque a calculadora é o gancho e precisa vir antes dos botões (spec §4).
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="kicker">App de treino · Powerlifting</span>
      <h1 id="hero-title" class="hero__title">{HERO_TITLE}</h1>
      <p class="hero__sub">{HERO_SUBTITLE}</p>
    </div>

    <div class="hero__calc">
      <StrengthCalculator mode="compacto" client:load />
    </div>

    <div class="hero__ctas">
      <CtaButtons variant="quiet" />
      <p class="hero__note">Sem cartão. As calculadoras funcionam sem conta.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--bg-primary);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    grid-template-areas:
      'copy calc'
      'ctas calc';
    align-items: start;
    column-gap: 72px;
    row-gap: 28px;
    padding-top: 96px;
    padding-bottom: 104px;
  }

  .hero__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 620px;
  }

  .hero__calc {
    grid-area: calc;
  }

  .hero__ctas {
    grid-area: ctas;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero__title {
    font-size: clamp(32px, 4.2vw, 52px);
    line-height: 1.08;
  }

  .hero__sub {
    font-size: 19px;
    line-height: 1.55;
    max-width: 520px;
  }

  .hero__note {
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 1023px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'copy'
        'calc'
        'ctas';
      row-gap: 32px;
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .hero__calc {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }

    .hero__copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero__inner {
      padding-top: 44px;
      padding-bottom: 40px;
      row-gap: 24px;
    }

    .hero__copy {
      gap: 18px;
    }

    .hero__sub {
      font-size: 16px;
    }

    .hero__note {
      text-align: center;
    }
  }
</style>
