---
import SectionHeader from '../components/SectionHeader.astro';
import PhoneTreino from '../components/phones/PhoneTreino.astro';
import PhoneDashboard from '../components/phones/PhoneDashboard.astro';
import PhoneAnalytics from '../components/phones/PhoneAnalytics.astro';
import PhoneResumo from '../components/phones/PhoneResumo.astro';

// Os 4 frames são HTML/CSS estáticos. No mobile (≤1023px) ficam num carrossel de
// scroll horizontal com snap (item 12 da revisão de 17/09/2026).
//
// A ordem é narrativa (issue #317, spec §4): abre → registra → fecha o treino →
// vê se evoluiu. Mexer na ordem dos <figure> muda a história que a seção conta.
---

<section class="section section--hairline-top app" aria-labelledby="app-title">
  <div class="container app__inner">
    <div class="app__head">
      <SectionHeader kicker="Um treino no ONYX" title="Do primeiro acesso ao PR." />
    </div>

    <div class="app__frames" id="app-frames">
      <figure class="app__frame app__frame--side">
        <PhoneDashboard />
        <figcaption>1 · Abre e vê a carga de hoje</figcaption>
      </figure>

      <figure class="app__frame">
        <PhoneTreino />
        <figcaption>2 · Registra a série e como ela foi</figcaption>
      </figure>

      <figure class="app__frame">
        <PhoneResumo />
        <figcaption>3 · Fecha o treino com os recordes do dia</figcaption>
      </figure>

      <figure class="app__frame app__frame--side">
        <PhoneAnalytics />
        <figcaption>4 · Vê se está ficando mais forte</figcaption>
      </figure>
    </div>

    <div class="app__dots" id="app-dots" aria-hidden="true">
      <span class="app__dot" data-i="0" />
      <span class="app__dot" data-i="1" />
      <span class="app__dot" data-i="2" />
      <span class="app__dot" data-i="3" />
    </div>
  </div>
</section>

<script>
  // Dots do carrossel mobile (mesma técnica da seção de diferenciais): destaca o
  // frame mais próximo do centro do track conforme o usuário desliza.
  const track = document.getElementById('app-frames');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('#app-dots .app__dot'));

  if (track && dots.length) {
    const update = () => {
      const frames = Array.from(track.querySelectorAll<HTMLElement>('.app__frame'));
      const trackRect = track.getBoundingClientRect();
      const centerX = trackRect.left + trackRect.width / 2;
      let closest = 0;
      let minDist = Infinity;
      frames.forEach((f, i) => {
        const r = f.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - centerX);
        if (dist < minDist) {
          minDist = dist;
          closest = i;
        }
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === closest));
    };

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .app__inner {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .app__frames {
    display: flex;
    gap: 24px;
    align-items: flex-end;
    justify-content: center;
  }

  .app__frame {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    margin: 0;
  }

  .app__frame figcaption {
    font-size: 13px;
    color: var(--text-secondary);
    text-align: center;
  }

  .app__dots {
    display: none;
    gap: 6px;
    justify-content: center;
  }

  .app__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--border-color);
    transition:
      background var(--transition-fast),
      width var(--transition-fast);
  }

  .app__dot.is-active {
    background: var(--accent);
    width: 18px;
  }

  @media (max-width: 1023px) {
    .app__frames {
      gap: 24px;
      flex-wrap: wrap;
    }
  }

  /* Abaixo de 1024px os frames viram um carrossel de scroll horizontal, 100% CSS. */
  @media (max-width: 640px) {
    .app__inner {
      gap: 20px;
    }

    .app__head {
      text-align: center;
    }

    .app__frames {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 0 4px 6px;
      scrollbar-width: none;
    }

    .app__frames::-webkit-scrollbar {
      display: none;
    }

    .app__frame {
      scroll-snap-align: center;
      flex: 0 0 auto;
    }

    .app__dots {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app__frames {
      scroll-behavior: auto;
    }
  }
</style>
