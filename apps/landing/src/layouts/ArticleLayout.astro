---
import BaseLayout from './BaseLayout.astro';
import { APP_URL, CTA_PRIMARY, EVERGREEN_PAGES, SITE_URL } from '../lib/site';

interface Props {
  title: string;
  h1?: string;
  description: string;
  path: string;
  updatedAt?: string;
  /** Rótulo curto para breadcrumb e "leia também" (default: title). */
  breadcrumb?: string;
  /** CTA de contexto: para uma calculadora específica, no lugar do CTA genérico do app. */
  relatedCalc?: { href: string; label: string };
}
const { title, h1, description, path, updatedAt, breadcrumb, relatedCalc } = Astro.props;
const heading = h1 ?? title;
const crumbLabel = breadcrumb ?? title;

const others = EVERGREEN_PAGES.filter((p) => p.href !== path);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: heading,
    description,
    url: `${SITE_URL}${path}`,
    inLanguage: 'pt-BR',
    ...(updatedAt ? { dateModified: updatedAt, datePublished: updatedAt } : {}),
    author: { '@type': 'Organization', name: 'ONYX', url: SITE_URL },
    publisher: { '@type': 'Organization', name: 'ONYX', url: SITE_URL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ONYX', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: crumbLabel, item: `${SITE_URL}${path}` },
    ],
  },
];

const updatedLabel = updatedAt
  ? new Date(`${updatedAt}T12:00:00-03:00`).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
  : null;
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} readingProgress>
  <article class="article">
    <div class="container article__inner">
      <nav class="article__crumbs" aria-label="Você está em">
        <a href="/">ONYX</a><span aria-hidden="true">/</span><span>{crumbLabel}</span>
      </nav>

      <div class="prose" id="article-content">
        <h1>{heading}</h1>
        {updatedLabel && <p class="meta">Última atualização: {updatedLabel}</p>}
        <slot />
      </div>

      <aside class="article__cta card">
        <div>
          <span class="kicker">No app</span>
          <h2 class="article__cta-title">
            {relatedCalc ? 'Faça esse cálculo com seus próprios números.' : 'Isso tudo já roda dentro do seu treino.'}
          </h2>
          <p>Registre com RPE, programe por %1RM e acompanhe DOTS, Wilks e IPF GL no seu histórico, grátis, em pt-BR e offline.</p>
        </div>
        {
          relatedCalc ? (
            <a class="btn btn--primary" href={relatedCalc.href}>{relatedCalc.label}</a>
          ) : (
            <a class="btn btn--primary" href={APP_URL}>{CTA_PRIMARY}</a>
          )
        }
      </aside>

      {
        others.length > 0 && (
          <nav class="article__others" aria-label="Leia também">
            <span class="label">Leia também</span>
            {others.map((p) => <a href={p.href}>{p.label} →</a>)}
          </nav>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  // Progresso de leitura: mede o quanto do conteúdo do artigo (#article-content)
  // já passou pela viewport, do topo até o texto inteiro ter rolado para cima.
  const el = document.getElementById('article-content');
  const fill = document.getElementById('reading-progress-fill');

  if (el && fill) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const elTop = el.offsetTop;
      const elHeight = el.offsetHeight;
      const denom = elHeight - window.innerHeight;
      const pct = denom > 0 ? ((window.scrollY - elTop) / denom) * 100 : 100;
      fill.style.width = `${Math.min(100, Math.max(0, pct))}%`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  }
</script>

<style>
  .article__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 56px;
    padding-bottom: 88px;
    max-width: 760px;
  }

  .article__crumbs {
    display: flex;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .article__crumbs a {
    color: var(--text-muted);
  }

  .article__crumbs a:hover {
    color: var(--text-secondary);
  }

  .article__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    background: var(--accent-gradient), var(--bg-secondary);
    border-color: var(--accent-border);
  }

  .article__cta-title {
    font-size: 20px;
    margin: 8px 0 8px;
  }

  .article__cta p {
    font-size: 14px;
    line-height: 1.6;
  }

  .article__others {
    display: flex;
    gap: 16px 20px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .article__inner {
      gap: 24px;
      padding-top: 32px;
      padding-bottom: 56px;
    }

    .article__cta {
      flex-direction: column;
      align-items: stretch;
      padding: 20px;
      text-align: left;
    }
  }
</style>
